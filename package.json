{
  "name": "patronum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Instagram login + scrape via local Stagehand (Qwen)",
  "scripts": {
    "patronum": "bun src/cmd/patronum.ts",
    "start": "bun src/cmd/cli.ts",
    "login": "bun src/cmd/cli.ts login",
    "session": "bun src/cmd/cli.ts session",
    "help": "bun src/cmd/cli.ts help",
    "notifications": "bun src/cmd/log-notifications.ts",
    "map": "bun src/cmd/map-elements.ts",
    "map:deep": "bun src/cmd/map-deep.ts",
    "scrape-profile": "bun src/cmd/scrape-profile.ts",
    "igflow": "go run ./cmd/igflow",
    "analyze-media": "go run ./cmd/iganalyze",
    "unique-media": "go run ./cmd/igunique",
    "secrets:decrypt": "bash scripts/secrets-decrypt.sh",
    "secrets:encrypt": "bash scripts/secrets-encrypt.sh",
    "postinstall": "node scripts/patch-stagehand-aisdk.mjs && node scripts/patch-stagehand-local-ws.mjs",
    "typecheck": "tsc --noEmit && tsc --project src/dashboard/web/tsconfig.json",
    "test": "bun test src",
    "dash": "bun run dash:build && bun src/dashboard/server.ts",
    "dash:build": "vite build --config src/dashboard/vite.config.ts",
    "dash:dev": "vite --config src/dashboard/vite.config.ts",
    "dash:serve": "bun src/dashboard/server.ts",
    "brand": "bun scripts/brand.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.46",
    "@base-ui/react": "1.8.0",
    "@browserbasehq/stagehand": "3.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@popmelt.com/core": "0.24.2",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "favicons": "7.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.5.0",
    "vite": "8.2.2"
  }
}
