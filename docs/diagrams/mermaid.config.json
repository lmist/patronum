{
  "theme": "base",
  "look": "classic",
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
  "themeVariables": {
    "background": "#ffffff",
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "fontSize": "16px",
    "textColor": "#0f172a",
    "lineColor": "#3b82f6",
    "primaryColor": "#93c5fd",
    "primaryBorderColor": "#3b82f6",
    "primaryTextColor": "#0f172a",
    "secondaryColor": "#bbf7d0",
    "secondaryBorderColor": "#22c55e",
    "secondaryTextColor": "#0f172a",
    "tertiaryColor": "#d8b4fe",
    "tertiaryBorderColor": "#8b5cf6",
    "tertiaryTextColor": "#0f172a",
    "noteBkgColor": "#fef3c7",
    "noteBorderColor": "#f59e0b",
    "noteTextColor": "#0f172a",
    "edgeLabelBackground": "#ffffff",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8",
    "titleColor": "#111827",
    "errorBkgColor": "#fecaca",
    "errorTextColor": "#b91c1c"
  },
  "themeCSS": ".node rect, .node circle, .node ellipse, .node polygon, .node path { stroke-width: 4px; } .edgePath .path, .flowchart-link { stroke-width: 4px; stroke-linecap: round; } .edgeLabel { font-weight: 700; } .nodeLabel { font-weight: 700; font-size: 18px; } .cluster-label { font-weight: 700; } .statediagram-state rect { stroke-width: 4px; } .transition { stroke-width: 4px; }",
  "flowchart": {
    "curve": "basis",
    "padding": 18,
    "nodeSpacing": 60,
    "rankSpacing": 90,
    "htmlLabels": true
  },
  "state": {
    "padding": 14
  }
}
