---
title: Patronum Session Lifecycle FSM
---
flowchart LR
  start(( )) -- open --> Launched["Chrome<br/>Launched"]
  Launched -- cookies valid --> Authed["Session<br/>Authenticated"]
  Launched -- login + TOTP --> Login["Login<br/>Flow"]
  Login -- success --> Authed
  Login -- challenge --> Challenged["Checkpoint /<br/>Challenge"]
  Challenged -. manual solve .-> Authed
  Authed -- scrape --> Scraping["Profile<br/>Scraping"]
  Scraping -- done --> Closed["Session<br/>Closed"]
  Authed -. --fresh-profile .-> Wiped["Profile<br/>Wiped"]
  Wiped -- relaunch --> Launched

  classDef blue fill:#93c5fd,stroke:#3b82f6,stroke-width:4px,color:#0f172a
  classDef green fill:#bbf7d0,stroke:#22c55e,stroke-width:4px,color:#0f172a
  classDef purple fill:#d8b4fe,stroke:#8b5cf6,stroke-width:4px,color:#0f172a
  classDef cyan fill:#a5f3fc,stroke:#06b6d4,stroke-width:4px,color:#0f172a
  classDef amber fill:#fde68a,stroke:#f59e0b,stroke-width:4px,color:#0f172a
  classDef red fill:#fecaca,stroke:#ef4444,stroke-width:4px,color:#0f172a
  classDef startDot fill:#111827,stroke:#111827

  class Launched blue
  class Authed green
  class Login purple
  class Scraping cyan
  class Challenged amber
  class Wiped,Closed red
  class start startDot

  linkStyle 0 stroke:#3b82f6,stroke-width:4px
  linkStyle 1 stroke:#22c55e,stroke-width:4px
  linkStyle 2 stroke:#8b5cf6,stroke-width:4px
  linkStyle 3 stroke:#22c55e,stroke-width:4px
  linkStyle 4 stroke:#f59e0b,stroke-width:3px
  linkStyle 5 stroke:#f59e0b,stroke-width:3px
  linkStyle 6 stroke:#06b6d4,stroke-width:4px
  linkStyle 7 stroke:#ef4444,stroke-width:4px
  linkStyle 8 stroke:#ef4444,stroke-width:3px
  linkStyle 9 stroke:#3b82f6,stroke-width:3px
