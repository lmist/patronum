# Copy to .env and fill in values (never commit .env):
#   cp .env.example .env

# Required — the model endpoint. Any OpenAI-compatible API works: one provider,
# or a router in front of many.
LLM_API_KEY=
LLM_BASE_URL=
# One model for everything...
LLM_MODEL=
# ...or one per role, when no single model does all three jobs:
#   browser  drives Chrome: text and structured output (a fast, cheap model is fine)
#   vision   reads sign-in image puzzles: image input
#   video    analyzes collected media: image and video input
# LLM_MODEL_BROWSER=
# LLM_MODEL_VISION=
# LLM_MODEL_VIDEO=
# How a video is attached: video_url (Qwen's own API), file (Gemini through most
# routers) or image_url. `patronum preflight` sends a short test video and tells
# you if the model did not receive it.
# LLM_VIDEO_FORMAT=file

# Using the Qwen Token Plan directly instead: set these and leave LLM_* empty.
# QWEN_API_KEY=
# QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-max

# The Instagram account Patronum signs in as (required)
IG_USER=
IG_PASS=

# Optional — only if authenticator 2FA is enabled
# IG_TOTP_SECRET=

# Optional — only if Instagram emails sign-in codes to the account: an
# AgentMail inbox attached to it, so Patronum can read the code itself
AGENTMAIL_ADDRESS=
AGENTMAIL_API_KEY=

# Optional — hide the Chrome window for command-line runs (default: visible).
# Collections started in the dashboard are already hidden; its Account page
# always shows the window so you can finish a verification.
# HEADLESS=true

# Optional — DBOS system database for durable igflow jobs (SQLite WAL).
# Default: sqlite:<home>/data/dbos/patronum.sqlite
# DBOS_SYSTEM_DATABASE_URL=sqlite:/abs/path/data/dbos/patronum.sqlite

# Optional — where Patronum keeps everything it collects and saves: profiles,
# media, analysis, the job database, logs, the saved Chrome login, caches.
# Default: ~/Documents/patronum. On a server, point this at the data volume.
# PATRONUM_HOME=/srv/patronum
